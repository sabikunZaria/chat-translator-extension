{
  "manifest_version": 3,
  "name": "Chat Translator",
  "version": "1.0",
  "description": "Real-time chat translation extension",
  "icons": {
    "128": "assets/icon.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ]
}
